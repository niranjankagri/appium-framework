<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full suite. One emulator, so tests run on one thread (one Appium session). -->
<suite name="Appium Framework" verbose="1">
	<test name="Android">
		<packages>
			<package name="com.automation.appium.tests.*" />
		</packages>
	</test>
</suite>
