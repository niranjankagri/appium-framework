<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.automation</groupId>
	<artifactId>appium-framework</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>appium-framework</name>
	<description>Android mobile test automation with Appium, Java and TestNG on the Sauce Labs My Demo App</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Same Java level as the other frameworks; runs on any newer JDK -->
		<maven.compiler.release>17</maven.compiler.release>
		<!-- Suite file; CI or a developer can point to another one -->
		<suiteXmlFile>testng.xml</suiteXmlFile>
	</properties>

	<dependencies>
		<!-- Appium Java client: AndroidDriver, UiAutomator2Options, AppiumBy (brings Selenium 4) -->
		<dependency>
			<groupId>io.appium</groupId>
			<artifactId>java-client</artifactId>
			<version>11.0.0</version>
		</dependency>
		<!-- Selenium waits (WebDriverWait, ExpectedConditions); the Appium client
		     no longer brings this module, so it is added here -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-support</artifactId>
			<version>4.51.0</version>
		</dependency>
		<!-- Test runner: groups, parallel runs, listeners, data providers -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.12.0</version>
		</dependency>
		<!-- Silences the SLF4J "no provider" warning from the Appium client -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<version>2.0.17</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Compiles for Java 17 (see maven.compiler.release) and reports deprecated API use -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<showDeprecation>true</showDeprecation>
				</configuration>
			</plugin>
			<!-- Runs the TestNG suite. Held at 3.5.6: 3.6.0 picks the JUnit Platform
			     provider in TestNG projects and ignores testng.xml and its listeners -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<suiteXmlFiles>
						<suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
					</suiteXmlFiles>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
